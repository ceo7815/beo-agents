OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Dedicated Telegram bot for ג'וני (not Shay / Adi). BotFather: Beo Chief | ג'וני
JOHNNY_TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Beo OS bot API (same key as BOT_API_KEY on the OS Node server)
BEO_OS_URL=https://os.beosystem.com
BOT_API_KEY=
JOHNNY_ACTOR_USER_ID=
JOHNNY_ACTOR_NAME=אור
JOHNNY_ACTOR_EMAIL=ceo@beosystem.co.il

# Google — ceo@ mailbox + Calendar + Meet (scopes: gmail.modify/send/readonly + calendar)
# Same GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET as Shay, different refresh token for ceo@beosystem.co.il
CEO_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ריווחית אונליין — future. Leave empty until you have API access. Do not fake data.
RIVHIT_API_KEY=
RIVHIT_TOKEN=
