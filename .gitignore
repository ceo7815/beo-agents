.env
**/.env
!.env.example
!**/.env.example

# Hermes runtime (per-agent volume)
agents/*/sessions/
agents/*/logs/
agents/*/cache/
agents/*/home/home/
agents/*/*.db
agents/*/*.db-wal
agents/*/*.db-shm
agents/*/state.db
agents/*/auth.json
agents/*/auth.lock
agents/*/gateway_state.json
agents/*/cron/jobs.json.bak
agents/*/cron/.tick.lock
agents/*/models_dev_cache.json
agents/*/.skills_prompt_snapshot.json
agents/*/memories/*.lock
agents/*/skills/*.lock

# Generated media and learning data stay on the server volume
agents/*/home/media/**
!agents/*/home/media/.gitkeep
agents/*/home/drafts/**
!agents/*/home/drafts/.gitkeep
agents/*/home/performance/**
!agents/*/home/performance/.gitkeep
agents/*/home/pipeline/*.json
agents/*/home/pipeline/*.tmp
!agents/*/home/pipeline/.gitkeep
agents/*/home/telegram/**
agents/*/home/power.json
agents/*/home/learning/**
!agents/*/home/learning/.gitkeep
agents/*/home/memories/**
agents/*/secrets/**
!agents/*/secrets/.gitkeep

dashboard/node_modules/
dashboard/dist/
control/__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
