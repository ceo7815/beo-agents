# Beo Social — secrets for THIS agent only.
# Copy to .env and fill. Never copy .env from another agent.

# Same Beo OpenAI key used for company work. Paste it here; do not read it from other profiles.
OPENAI_API_KEY=

# New bot from @BotFather. Not Titatu, not Mochka, not any client bot.
TELEGRAM_BOT_TOKEN=

# Or's numeric Telegram user id from @userinfobot (not the number at the start of the bot token).
TELEGRAM_ALLOWED_USERS=

# Optional. This chat id (same as Or's user id for a private DM) skips the Hermes /sethome nag.
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_HOME_CHANNEL_NAME=Or
